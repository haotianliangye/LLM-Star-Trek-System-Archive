{
  "entities": {
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A single message in a chat history.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user."
        },
        "nodeId": {
          "type": "string",
          "description": "The ID of the concept node."
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "description": "The role of the message sender."
        },
        "text": {
          "type": "string",
          "description": "The text content of the message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the message was created."
        }
      },
      "required": ["userId", "nodeId", "role", "text", "createdAt"]
    }
  },
  "firestore": {
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Stores individual chat messages."
    }
  }
}
