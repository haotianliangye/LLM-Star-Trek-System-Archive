rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'nodeId', 'role', 'text', 'createdAt'])
        && data.keys().size() == 5
        && data.userId == request.auth.uid
        && data.nodeId is string
        && data.role in ['user', 'model']
        && data.text is string
        && data.createdAt == request.time;
    }

    match /chat_messages/{messageId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(messageId) && isValidChatMessage(incoming());
      
      // Updates are not allowed for chat messages - they are append only.
      allow update: if false;
      allow delete: if false;
    }
  }
}
